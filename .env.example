# DayMate configuration. Copy to `.env` and fill in real values locally.
# NEVER commit `.env`.

# ── Walrus Memory (Mainnet) — SERVER-ONLY ─────────────────────────────────
# Never prefix these with NEXT_PUBLIC_.

# Your Walrus Memory account object ID (0x… Sui object ID shown at https://memory.walrus.xyz).
# This is the account object ID, NOT your wallet address.
MEMWAL_ACCOUNT_ID=0xYOUR_MEMWAL_ACCOUNT_OBJECT_ID

# Delegate private key (Ed25519, 64 hex chars, optionally 0x-prefixed, or suiprivkey1…)
# generated and registered on your account at https://memory.walrus.xyz.
# This is a DELEGATE key — never use your wallet/account owner's private key here.
MEMWAL_PRIVATE_KEY=YOUR_DELEGATE_PRIVATE_KEY

# Walrus Memory relayer. Default is the official production Mainnet relayer.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Namespace for the Phase 1 CLI scripts (seed/recall/verify). The web app
# writes each elder's memories to its own namespace: daymate-elder-<uuid>.
MEMWAL_NAMESPACE=daymate-phase1

# ── Supabase (Phase 2) ────────────────────────────────────────────────────
# Project URL and publishable (anon) key: public by design (used in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Service-role / secret key: SERVER-ONLY. Bypasses RLS. Used only to record
# Walrus sync results and by the verification scripts. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY

# ── Sui Mainnet anchoring + Tatum verification (Phase 3B) — SERVER-ONLY ───
# Never prefix these with NEXT_PUBLIC_. See docs/PHASE3B_SUI.md.

# Master switch. Keep "false" until the synthetic Mainnet anchor has been
# verified through Tatum (npm run sui:anchor-synthetic -- --confirm-mainnet).
SUI_ANCHOR_ENABLED=false

# Package ID printed by `sui client publish` for move/daymate_anchor (0x…).
SUI_ANCHOR_PACKAGE_ID=0xYOUR_PUBLISHED_PACKAGE_ID

# Private key of the ONE dedicated DayMate project wallet that pays gas and
# signs anchor transactions (suiprivkey1… Ed25519). NOT a caregiver's wallet,
# NOT the Walrus delegate key above. Fund it with a small amount of SUI only.
SUI_ANCHOR_PRIVATE_KEY=YOUR_SUIPRIVKEY_FOR_THE_PROJECT_WALLET

# Sui full node used to SUBMIT transactions (gRPC). Default: Mysten's public
# Mainnet full node (rate-limited; fine for low volume). Verification never
# uses this node — it goes through Tatum.
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Tatum API key (https://dashboard.tatum.io), sent as the x-api-key header.
TATUM_API_KEY=YOUR_TATUM_API_KEY

# Tatum Sui Mainnet gRPC gateway used for independent verification.
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
